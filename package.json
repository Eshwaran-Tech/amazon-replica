{
  "name": "amazon-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "art": "tsx scripts/generate-product-art.ts",
    "categories:fetch": "tsx scripts/fetch-category-images.ts",
    "categories:slice": "tsx scripts/slice-category-sheet.ts",
    "products:fetch-images": "tsx scripts/fetch-product-images.ts",
    "banners:fetch": "tsx scripts/fetch-banners.ts",
    "giftcards:mint": "tsx --env-file=.env.local scripts/mint-gift-cards.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:indexes": "tsx --env-file=.env.local scripts/ensure-indexes.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-connection.ts",
    "db:reset-activity": "tsx --env-file=.env.local scripts/reset-activity.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
