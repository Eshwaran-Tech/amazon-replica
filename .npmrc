# Keep the content-addressable store on the same volume as the project.
# pnpm hard-links from the store into node_modules; a store on another drive
# forces full copies and can fail with EXDEV on Windows.
store-dir=D:/.pnpm-store

# Fail loudly on a lockfile that does not match package.json in CI.
# (Locally `pnpm install` still updates it.)
strict-peer-dependencies=false
auto-install-peers=true
