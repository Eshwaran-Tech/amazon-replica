# =============================================================================
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Nothing in this file may be prefixed NEXT_PUBLIC_ unless it is safe to ship
# to every browser that loads the site -- that prefix inlines the value into
# the client bundle.
# =============================================================================

# --- Database ----------------------------------------------------------------
# MongoDB Atlas SRV connection string. Server-only. Use a least-privilege user
# scoped to this one database (readWrite on MONGODB_DB, nothing else).
MONGODB_URI=
MONGODB_DB=amazon_next

# --- Auth --------------------------------------------------------------------
# HMAC key for CSRF tokens and other signed values.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating it invalidates all CSRF tokens.
AUTH_SECRET=

# Session lifetime in seconds (default 60 * 60 * 24 * 7 = 604800, i.e. 7 days).
SESSION_MAX_AGE_SECONDS=604800

# --- App ---------------------------------------------------------------------
# Canonical public origin. Used for CSRF Origin checks, absolute links in
# emails, sitemap and Open Graph URLs. No trailing slash.
#
# In production this MUST match the domain the site is actually served from.
# Every canonical tag and every sitemap entry is built from it, so a stale value
# points search engines at a host that may not answer. If it is left blank the
# app falls back to NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, which Vercel
# injects automatically -- but an explicit value always wins, so update it when
# you attach a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Branding (optional) -----------------------------------------------------
# Wordmark text. The accent stroke sizes itself to whatever you set, so no
# CSS needs changing when the name length changes.
# NEXT_PUBLIC_BRAND_NAME=Eshwaran
# NEXT_PUBLIC_BRAND_SUFFIX=.in
#
# The customer-facing support address. Defaults to support@<brand domain>.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@eshwaran.in
#
# Or replace the text wordmark entirely with an image asset.
# Must be a local path under public/ -- a remote URL is ignored, because the
# image optimiser would fetch it and become a request forwarder.
# NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
# NEXT_PUBLIC_BRAND_LOGO_MARK=/brand/mark.svg

# --- Payments ----------------------------------------------------------------
# "mock"   -> built-in gateway, no external account needed (development default)
# "stripe" -> requires the two Stripe keys plus the webhook secret below
PAYMENT_PROVIDER=mock

PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# "console" -> OTPs and reset links are written to the SERVER LOG, not sent.
#              Fine for development. In production it means nobody can register
#              or sign in by email, because the code never reaches an inbox.
# "smtp"    -> real delivery; requires SMTP_URL below.
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@example.com

# Connection URL for the mail provider. Required when EMAIL_TRANSPORT=smtp.
#   smtps://user:pass@smtp.provider.com:465   implicit TLS  (port defaults to 465)
#   smtp://user:pass@smtp.provider.com:587    STARTTLS      (port defaults to 587)
# Percent-encode the password if it contains @ / : or ?, exactly as for
# MONGODB_URI -- `p@ss` becomes `p%40ss`.
# EMAIL_FROM must be an address the provider has authorised you to send from,
# or mail will be accepted and then silently dropped.
SMTP_URL=

# --- Demo --------------------------------------------------------------------
# Shows the one-time password on the verification page instead of relying on it
# being delivered. Useful when no mail provider is configured.
#
# Understand the trade before enabling it: anyone can type somebody else's
# address, request a code, read it off the screen and sign in as them. That is
# account takeover. Only for a demonstration deployment with no real accounts.
# Off unless set to exactly "true".
DEMO_SHOW_OTP=false

# --- Seeding (development only) ----------------------------------------------
# Credentials for the seeded admin account. The seed refuses to run against
# NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
