# =============================================================================
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Nothing in this file may be prefixed NEXT_PUBLIC_ unless it is safe to ship
# to every browser that loads the site -- that prefix inlines the value into
# the client bundle.
# =============================================================================

# --- Database ----------------------------------------------------------------
# MongoDB Atlas SRV connection string. Server-only. Use a least-privilege user
# scoped to this one database (readWrite on MONGODB_DB, nothing else).
MONGODB_URI=
MONGODB_DB=amazon_next

# --- Auth --------------------------------------------------------------------
# HMAC key for CSRF tokens and other signed values.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating it invalidates all CSRF tokens.
AUTH_SECRET=

# Session lifetime in seconds (default 60 * 60 * 24 * 7 = 604800, i.e. 7 days).
SESSION_MAX_AGE_SECONDS=604800

# --- App ---------------------------------------------------------------------
# Canonical public origin. Used for CSRF Origin checks, absolute links in
# emails, sitemap and Open Graph URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Branding (optional) -----------------------------------------------------
# Wordmark text. The accent stroke sizes itself to whatever you set, so no
# CSS needs changing when the name length changes.
# NEXT_PUBLIC_BRAND_NAME=Eshwaran
# NEXT_PUBLIC_BRAND_SUFFIX=.in
#
# Or replace the text wordmark entirely with an image asset.
# Must be a local path under public/ -- a remote URL is ignored, because the
# image optimiser would fetch it and become a request forwarder.
# NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
# NEXT_PUBLIC_BRAND_LOGO_MARK=/brand/mark.svg

# --- Payments ----------------------------------------------------------------
# "mock"   -> built-in gateway, no external account needed (development default)
# "stripe" -> requires the two Stripe keys plus the webhook secret below
PAYMENT_PROVIDER=mock

PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# "console" -> verification / reset links are written to the server log
# "smtp"    -> requires the SMTP_* settings
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@example.com

# --- Seeding (development only) ----------------------------------------------
# Credentials for the seeded admin account. The seed refuses to run against
# NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
